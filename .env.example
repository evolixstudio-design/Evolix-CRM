# Neon PostgreSQL (get from https://console.neon.tech)
# Use the pooled connection string for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-xxx.region.neon.tech/evolix_os?sslmode=require"
# Use the direct (non-pooled) connection string for DIRECT_URL
DIRECT_URL="postgresql://user:password@ep-xxx.region.neon.tech/evolix_os?sslmode=require"

# Authentication Secret (min 32 chars, generate a random one for production)
AUTH_SECRET="your-production-secret-min-32-characters-here"

# Application Environment
NODE_ENV="production"
