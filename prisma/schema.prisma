generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum UserRole {
  CO_FOUNDER
  INTERN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  WHATSAPP
  WEBSITE
  REFERRAL
  UPWORK
  FIVERR
  FREELANCER
  COLD_OUTREACH
  GOOGLE
  COLD_CALL
  EMAIL
  EXISTING_CLIENT
  WALK_IN
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  FOLLOW_UP
  STATUS_CHANGE
  ASSIGNMENT
}

enum CallOutcome {
  CONNECTED
  NOT_CONNECTED
  BUSY
  CALL_BACK
  INTERESTED
  NOT_INTERESTED
  WRONG_NUMBER
  MEETING_FIXED
  OTHER
}

enum FollowUpType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

enum MeetingType {
  ONLINE
  OFFLINE
  PHONE
  GOOGLE_MEET
  ZOOM
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum RecipientType {
  INTERNAL_USER
  CLIENT
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum ClientStatus {
  ONBOARDING
  ACTIVE
  ON_HOLD
  COMPLETED
  INACTIVE
  ARCHIVED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  CANCELLED
}

enum ProjectServiceType {
  WEBSITE
  SOFTWARE
  BRANDING
  SOCIAL_MEDIA
  DIGITAL_MARKETING
  SEO
  THREE_D_ANIMATION
  PRODUCT_PHOTOGRAPHY
  ECOMMERCE
  AI_AUTOMATION
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ProjectMemberRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model ExpenseCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  isPredefined Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("expense_categories")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_ACCEPTED
  TASK_DECLINED
  TASK_SUBMITTED
  TASK_DUE
  TASK_OVERDUE
  CLIENT_ASSIGNED
  PROJECT_ASSIGNED
  PROJECT_COMPLETED
  LEAD_CONVERTED
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  FOLLOW_UP_DUE
  MEETING_SCHEDULED
  MEETING_REMINDER
  MEETING_COMPLETED
  SYSTEM
}

enum ActivityAction {
  USER_LOGIN
  USER_LOGOUT
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STATUS_CHANGED
  LEAD_CONVERTED
  CALL_LOGGED
  FOLLOW_UP_CREATED
  FOLLOW_UP_UPDATED
  MEETING_SCHEDULED
  MEETING_COMPLETED
  QUOTATION_CREATED
  QUOTATION_UPDATED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_CONVERTED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_COMPLETED
  PHASE_CREATED
  PHASE_UPDATED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_ACCEPTED
  TASK_DECLINED
  TASK_SUBMITTED
  PROOF_UPLOADED
  APPROVAL_GRANTED
  APPROVAL_REJECTED
  TASK_COMPLETED
  INVOICE_CREATED
  INVOICE_UPDATED
  PAYMENT_CREATED
  PAYMENT_RECORDED
  PAYMENT_UPDATED
  EXPENSE_CREATED
  EXPENSE_RECORDED
  EXPENSE_UPDATED
  ATTENDANCE_CHECKIN
  ATTENDANCE_CHECKOUT
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  PERMISSION_CHANGED
}

enum EntityType {
  USER
  LEAD
  CLIENT
  ONBOARDING
  PROJECT
  PHASE
  TASK
  QUOTATION
  INVOICE
  PAYMENT
  EXPENSE
  MEETING
  CALL
  ATTENDANCE
  SYSTEM
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  email               String             @unique
  passwordHash        String?
  role                UserRole
  phone               String?
  department          String?
  avatarUrl           String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  assignedLeads       Lead[]             @relation("LeadAssignee")
  leadActivities      LeadActivity[]
  assignedClients     Client[]           @relation("ClientAssignee")
  assignedClientsAsIntern Client[]       @relation("ClientInternAssignee")
  ownedProjects       Project[]          @relation("ProjectOwner")
  projectMemberships  ProjectMember[]
  assignedTasks       Task[]             @relation("TaskAssignee")
  assignedTasksAsIntern Task[]           @relation("TaskInternAssignee")
  createdTasks        Task[]             @relation("TaskCreator")
  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]   @relation("AttachmentUploader")
  noteAttachments     NoteAttachment[]   @relation("NoteAttachmentUploader")
  leadFollowUpsAssigned LeadFollowUp[]   @relation("LeadFollowUpAssignee")
  leadFollowUpsCreated  LeadFollowUp[]   @relation("LeadFollowUpCreator")
  createdQuotations     Quotation[]      @relation("QuotationCreator")
  createdInvoices       Invoice[]        @relation("InvoiceCreator")
  createdRecurringContracts RecurringContract[] @relation("RecurringContractCreator")
  organizedMeetings     Meeting[]        @relation("MeetingOrganizer")
  meetingReminders      MeetingReminder[] @relation("InternalUserReminder")
  paymentsRecorded    Payment[]          @relation("PaymentRecorder")
  expensesRecorded    Expense[]          @relation("ExpenseRecorder")
  notifications       Notification[]
  activityLogs        ActivityLog[]
  attendanceRecords   Attendance[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Lead {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  companyName       String?
  email             String?
  phone             String?
  country           String?
  source            LeadSource
  service           String?
  status            LeadStatus      @default(NEW)
  priority          LeadPriority    @default(MEDIUM)
  estimatedValue    Decimal?        @db.Decimal(12, 2)
  assignedToId      String?         @db.Uuid
  nextFollowUpAt    DateTime?
  notes             String?
  convertedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  assignedTo        User?           @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities        LeadActivity[]
  followUps         LeadFollowUp[]
  meetings          Meeting[]
  quotations        Quotation[]
  convertedClient   Client?         @relation("LeadConversion")

  @@index([status])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
  @@index([source])
  @@map("leads")
}

model LeadActivity {
  id          String             @id @default(uuid()) @db.Uuid
  leadId      String             @db.Uuid
  userId      String             @db.Uuid
  type        LeadActivityType
  content     String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@map("lead_activities")
}

model LeadFollowUp {
  id           String       @id @default(uuid()) @db.Uuid
  leadId       String       @db.Uuid
  type         FollowUpType @default(CALL)
  notes        String?
  dueDate      DateTime
  assignedToId String?      @db.Uuid
  isCompleted  Boolean      @default(false)
  completedAt  DateTime?
  createdById  String       @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("LeadFollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("LeadFollowUpCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, dueDate])
  @@index([assignedToId, isCompleted, dueDate])
  @@index([dueDate, isCompleted])
  @@map("lead_follow_ups")
}

model Client {
  id                    String        @id @default(uuid()) @db.Uuid
  name                  String
  companyName           String?
  email                 String?
  phone                 String?
  whatsapp              String?
  address               String?
  country               String?
  website               String?
  industry              String?
  status                ClientStatus  @default(ONBOARDING)
  source                LeadSource?
  assignedToId          String?       @db.Uuid
  assignedInternId      String?       @db.Uuid
  convertedFromLeadId   String?       @unique @db.Uuid
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  assignedTo            User?         @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedIntern        User?         @relation("ClientInternAssignee", fields: [assignedInternId], references: [id], onDelete: SetNull)
  convertedFromLead     Lead?         @relation("LeadConversion", fields: [convertedFromLeadId], references: [id], onDelete: SetNull)
  onboarding            Onboarding?
  projects              Project[]
  tasks                 Task[]
  meetings              Meeting[]
  quotations            Quotation[]
  invoices              Invoice[]
  payments              Payment[]
  expenses              Expense[]
  recurringContracts    RecurringContract[]

  @@index([status])
  @@index([assignedToId])
  @@index([assignedInternId])
  @@index([companyName])
  @@map("clients")
}

model Onboarding {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @unique @db.Uuid
  status       OnboardingStatus @default(NOT_STARTED)
  businessInfo String?
  contactInfo  String?
  services     String?
  startDate    DateTime?
  targetEndDate DateTime?
  completedAt  DateTime?
  dealInfo     String?
  documents    String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("onboardings")
}

model Project {
  id             String             @id @default(uuid()) @db.Uuid
  clientId       String             @db.Uuid
  name           String
  description    String?
  serviceType    ProjectServiceType
  status         ProjectStatus      @default(PLANNING)
  priority       ProjectPriority    @default(MEDIUM)
  startDate      DateTime?
  deadline       DateTime?
  completedAt    DateTime?
  contractValue  Decimal?           @db.Decimal(12, 2)
  currency       String             @default("INR")
  paymentStatus  PaymentStatus      @default(UNPAID)
  contractType   String             @default("FIXED_PRICE")
  duration       String?
  ownerId        String?            @db.Uuid
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner          User?              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  phases         ProjectPhase[]
  tasks          Task[]
  invoices       Invoice[]
  payments       Payment[]
  expenses       Expense[]
  recurringContracts RecurringContract[]

  @@index([clientId])
  @@index([status])
  @@index([deadline])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @db.Uuid
  userId      String             @db.Uuid
  role        ProjectMemberRole  @default(MEMBER)
  createdAt   DateTime           @default(now())

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id               String       @id @default(uuid()) @db.Uuid
  projectId        String       @db.Uuid
  clientId         String       @db.Uuid
  title            String
  description      String?
  status           TaskStatus   @default(ASSIGNED)
  priority         TaskPriority @default(MEDIUM)
  assignedToId     String?      @db.Uuid
  assignedInternId String?      @db.Uuid
  createdById      String       @db.Uuid
  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?
  declineReason    String?
  phaseId          String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phase            ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignedTo       User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedIntern   User?        @relation("TaskInternAssignee", fields: [assignedInternId], references: [id], onDelete: SetNull)
  createdBy        User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments         TaskComment[]
  attachments      TaskAttachment[]

  @@index([projectId])
  @@index([clientId])
  @@index([assignedToId, status])
  @@index([assignedToId, dueDate])
  @@index([assignedInternId])
  @@index([status])
  @@map("tasks")
}

model TaskComment {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @db.Uuid
  userId      String    @db.Uuid
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskAttachment {
  id            String    @id @default(uuid()) @db.Uuid
  taskId        String    @db.Uuid
  uploadedById  String    @db.Uuid
  fileName      String
  fileUrl       String
  fileType      String?
  fileSize      Int?
  createdAt     DateTime  @default(now())

  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy    User      @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachments")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  clientId      String        @db.Uuid
  projectId     String?       @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  reference     String?
  notes         String?
  recordedById  String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  invoiceId     String?       @db.Uuid
  phaseId       String?       @db.Uuid
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  phase         ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  recordedBy    User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([clientId, status])
  @@index([projectId, status])
  @@index([phaseId])
  @@index([status, paymentDate])
  @@map("payments")
}

model Expense {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String?         @db.Uuid
  clientId       String?         @db.Uuid
  category       String
  description    String
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime
  vendor         String?
  paymentMethod  PaymentMethod?
  recordedById   String          @db.Uuid
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recordedBy     User            @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([projectId, expenseDate])
  @@index([expenseDate])
  @@index([category])
  @@map("expenses")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String
  message     String
  entityType  EntityType?
  entityId    String?          @db.Uuid
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  action      ActivityAction
  entityType  EntityType
  entityId    String?       @db.Uuid
  metadata    Json?
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model ProjectPhase {
  id                  String        @id @default(uuid()) @db.Uuid
  projectId           String        @db.Uuid
  name                String
  description         String?
  startDate           DateTime?
  endDate             DateTime?
  dueDate             DateTime?
  amount              Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus       PaymentStatus @default(UNPAID)
  paymentReceivedDate DateTime?
  invoiceId           String?       @db.Uuid
  status              PhaseStatus   @default(NOT_STARTED)
  progress            Int           @default(0)
  order               Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice             Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  tasks               Task[]
  payments            Payment[]

  @@index([projectId])
  @@index([status])
  @@index([paymentStatus])
  @@index([invoiceId])
  @@map("project_phases")
}

model Meeting {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  leadId       String?       @db.Uuid
  clientId     String?       @db.Uuid
  meetingDate  DateTime
  startTime    String
  endTime      String
  type         MeetingType   @default(GOOGLE_MEET)
  meetingLink  String?
  location     String?
  participants String?
  notes        String?
  status       MeetingStatus @default(SCHEDULED)
  organizerId  String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organizer    User          @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  reminders    MeetingReminder[]

  @@index([leadId])
  @@index([clientId])
  @@index([meetingDate, status])
  @@index([organizerId])
  @@map("meetings")
}

model MeetingReminder {
  id            String         @id @default(uuid()) @db.Uuid
  meetingId     String         @db.Uuid
  recipientType RecipientType  @default(INTERNAL_USER)
  recipientId   String?        @db.Uuid
  recipientName String?
  recipientEmail String?
  remindAt      DateTime
  channel       String         @default("NOTIFICATION")
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  notes         String?
  createdAt     DateTime       @default(now())

  meeting       Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recipient     User?          @relation("InternalUserReminder", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([remindAt, status])
  @@index([recipientId])
  @@map("meeting_reminders")
}

model NoteAttachment {
  id            String      @id @default(uuid()) @db.Uuid
  entityType    EntityType
  entityId      String      @db.Uuid
  uploadedById  String      @db.Uuid
  fileName      String
  fileUrl       String
  fileType      String?
  fileSize      Int?
  createdAt     DateTime    @default(now())

  uploadedBy    User        @relation("NoteAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@map("note_attachments")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  quotationNumber String          @unique
  leadId          String?         @db.Uuid
  clientId        String?         @db.Uuid
  createdById     String          @db.Uuid

  contactName     String
  companyName     String?
  email           String?
  phone           String?

  status          QuotationStatus @default(DRAFT)
  currency        String          @default("INR")
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  taxRate         Decimal         @default(0) @db.Decimal(5, 2)
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)

  validUntil      DateTime?
  terms           String?
  notes           String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy       User            @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items           QuotationItem[]

  @@index([leadId])
  @@index([clientId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  description String
  quantity    Int       @default(1)
  unitRate    Decimal   @default(0) @db.Decimal(12, 2)
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  order       Int       @default(0)

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  projectId     String?       @db.Uuid
  clientId      String        @db.Uuid
  createdById   String        @db.Uuid

  issueDate     DateTime      @default(now())
  dueDate       DateTime?

  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("INR")
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)

  terms         String?
  notes         String?
  recurringContractId       String?                  @db.Uuid
  recurringBillingPeriodId  String?                  @unique @db.Uuid

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project                 Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client                  Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy               User                    @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items                   InvoiceItem[]
  payments                Payment[]
  phases                  ProjectPhase[]
  recurringContract       RecurringContract?      @relation("ContractInvoices", fields: [recurringContractId], references: [id], onDelete: SetNull)
  recurringBillingPeriod  RecurringBillingPeriod? @relation("BillingPeriodInvoice", fields: [recurringBillingPeriodId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([recurringContractId])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(uuid()) @db.Uuid
  invoiceId   String    @db.Uuid
  description String
  quantity    Int       @default(1)
  unitRate    Decimal   @default(0) @db.Decimal(12, 2)
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  order       Int       @default(0)

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model RecurringContract {
  id                String                   @id @default(uuid()) @db.Uuid
  title             String
  clientId          String                   @db.Uuid
  projectId         String?                  @db.Uuid
  createdById       String                   @db.Uuid
  startDate         DateTime
  endDate           DateTime
  durationMonths    Int                      @default(12)
  billingFrequency  String                   @default("MONTHLY")
  monthlyAmount     Decimal                  @default(0) @db.Decimal(12, 2)
  currency          String                   @default("INR")
  status            String                   @default("ACTIVE")
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  client            Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project           Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy         User                     @relation("RecurringContractCreator", fields: [createdById], references: [id], onDelete: Restrict)
  billingPeriods    RecurringBillingPeriod[]
  invoices          Invoice[]                @relation("ContractInvoices")

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@map("recurring_contracts")
}

model RecurringBillingPeriod {
  id              String            @id @default(uuid()) @db.Uuid
  contractId      String            @db.Uuid
  periodNumber    Int
  periodStartDate DateTime
  periodEndDate   DateTime
  dueDate         DateTime
  amount          Decimal           @default(0) @db.Decimal(12, 2)
  invoiceId       String?           @db.Uuid
  status          String            @default("PENDING")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  contract        RecurringContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoice         Invoice?          @relation("BillingPeriodInvoice")

  @@unique([contractId, periodNumber])
  @@index([contractId])
  @@index([invoiceId])
  @@index([status])
  @@index([dueDate])
  @@map("recurring_billing_periods")
}

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("attendance")
}
